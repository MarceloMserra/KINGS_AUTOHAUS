<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Política de Privacidade - KINGS AUTOHAUS</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* Reset e configurações globais */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #000000 !important;
            color: #ffffff;
            overflow-x: hidden;
            font-family: 'Inter', sans-serif;
        }

        /* Container principal com a imagem de fundo */
        .privacy-container {
            min-height: 100vh;
            background-image: url('/images/privacy.png'); /* Substitua por sua imagem */
            background-size: cover;
            background-attachment: fixed;
            background-position: center;
            background-repeat: no-repeat;
            position: relative;
            padding-top: 150px;
            padding-bottom: 50px;
        }

        /* Conteúdo principal com transparência */
        .privacy-content {
            max-width: 1000px;
            margin: 0 auto;
            padding: 0 20px;
            position: relative;
            z-index: 2;
            background: rgba(26, 26, 26, 0.4);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid rgba(5, 252, 4, 0.2);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            overflow: hidden;
        }

        /* Header da política */
        .privacy-header {
            text-align: center;
            padding: 50px 30px;
            background: rgba(5, 252, 4, 0.05);
            border-bottom: 1px solid rgba(5, 252, 4, 0.2);
            margin-bottom: 40px;
        }

        .privacy-title {
            font-size: clamp(2.5rem, 6vw, 4rem);
            font-weight: bold;
            color: #05FC04;
            margin-bottom: 15px;
            text-shadow: 0 0 20px rgba(5, 252, 4, 0.5);
            animation: titleGlow 3s ease-in-out infinite alternate;
        }

        @keyframes titleGlow {
            0% { text-shadow: 0 0 20px rgba(5, 252, 4, 0.5); }
            100% { text-shadow: 0 0 30px rgba(5, 252, 4, 0.8), 0 0 40px rgba(5, 252, 4, 0.3); }
        }

        .privacy-subtitle {
            font-size: clamp(1rem, 3vw, 1.3rem);
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .last-updated {
            background: rgba(5, 252, 4, 0.1);
            border: 1px solid rgba(5, 252, 4, 0.3);
            border-radius: 25px;
            padding: 10px 20px;
            display: inline-block;
            font-size: 0.9rem;
            color: #05FC04;
            font-weight: bold;
        }

        /* Corpo do conteúdo */
        .privacy-body {
            padding: 30px;
            line-height: 1.8;
        }

        /* Seções */
        .privacy-section {
            margin-bottom: 40px;
            padding: 25px;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 15px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
            animation: fadeInUp 0.6s ease-out;
        }

        .privacy-section:hover {
            background: rgba(5, 252, 4, 0.05);
            border-color: rgba(5, 252, 4, 0.3);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(5, 252, 4, 0.1);
        }

        .section-title {
            font-size: clamp(1.5rem, 4vw, 2rem);
            color: #05FC04;
            margin-bottom: 20px;
            font-weight: bold;
            position: relative;
        }

        /* Parágrafos e listas */
        .privacy-text {
            font-size: clamp(1rem, 2.5vw, 1.1rem);
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 15px;
            text-align: justify;
        }

        .privacy-list {
            list-style: none;
            padding-left: 0;
            margin: 20px 0;
        }

        .privacy-list li {
            padding: 8px 0 8px 20px;
            position: relative;
            color: rgba(255, 255, 255, 0.85);
            transition: color 0.3s ease;
        }

        .privacy-list li::before {
            content: '•';
            position: absolute;
            left: 0;
            color: #05FC04;
            font-weight: bold;
            font-size: 1.2em;
        }

        .privacy-list li:hover {
            color: #ffffff;
        }

        /* Links */
        .privacy-link {
            color: #05FC04;
            text-decoration: none;
            border-bottom: 1px solid transparent;
            transition: all 0.3s ease;
        }

        .privacy-link:hover {
            color: #04D803;
            border-bottom-color: #04D803;
            text-shadow: 0 0 5px rgba(5, 252, 4, 0.5);
            text-decoration: none;
        }

        /* Tabela de categorias */
        .data-categories-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 10px;
            overflow: hidden;
        }

        .data-categories-table th,
        .data-categories-table td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid rgba(5, 252, 4, 0.2);
        }

        .data-categories-table th {
            background: rgba(5, 252, 4, 0.1);
            color: #05FC04;
            font-weight: bold;
        }

        .data-categories-table tr:hover {
            background: rgba(5, 252, 4, 0.05);
        }

        /* Seção de contato destacada */
        .contact-section {
            background: transparent;
            border: 2px solid rgba(5, 252, 4, 0.3);
            padding: 30px;
            border-radius: 15px;
            text-align: center;
            margin-top: 40px;
        }

        .contact-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .contact-item {
            background: rgba(0, 0, 0, 0.3);
            padding: 15px;
            border-radius: 10px;
            border: 1px solid rgba(5, 252, 4, 0.2);
            transition: all 0.3s ease;
        }

        .contact-item:hover {
            background: rgba(5, 252, 4, 0.1);
            transform: translateY(-2px);
        }

        .contact-item i {
            color: #05FC04;
            font-size: 1.5rem;
            margin-bottom: 10px;
        }

        /* Scroll suave */
        .privacy-container {
            scroll-behavior: smooth;
        }

        /* Animações de entrada */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in {
            animation: fadeInUp 0.6s ease-out;
        }

        .delay-1 { animation-delay: 0.1s; animation-fill-mode: both; }
        .delay-2 { animation-delay: 0.2s; animation-fill-mode: both; }
        .delay-3 { animation-delay: 0.3s; animation-fill-mode: both; }
        .delay-4 { animation-delay: 0.4s; animation-fill-mode: both; }

        /* Responsividade */
        @media (max-width: 768px) {
            .privacy-container {
                padding-top: 120px;
            }
            .privacy-content {
                margin: 0 10px;
                border-radius: 15px;
            }
            .privacy-header {
                padding: 30px 20px;
            }
            .privacy-body {
                padding: 20px;
            }
            .privacy-section {
                padding: 20px;
                margin-bottom: 25px;
            }
            .section-title {
                padding-left: 0;
            }
            .contact-info {
                grid-template-columns: 1fr;
            }
            .data-categories-table {
                font-size: 0.9rem;
            }
            .data-categories-table th,
            .data-categories-table td {
                padding: 10px;
            }
        }

        @media (max-width: 480px) {
            .privacy-header {
                padding: 20px 15px;
            }
            .privacy-body {
                padding: 15px;
            }
            .privacy-section {
                padding: 15px;
            }
        }

        /* Indicador de progresso de leitura */
        .reading-progress {
            position: fixed;
            top: 0;
            left: 0;
            width: 0%;
            height: 3px;
            background: linear-gradient(90deg, #05FC04, #04D803);
            z-index: 9999;
            transition: width 0.1s ease;
        }
    </style>
</head>
<body>

<div class="privacy-container">
    <!-- Indicador de progresso de leitura -->
    <div class="reading-progress" id="readingProgress"></div>
    <div class="privacy-content">
        <!-- Header -->
        <div class="privacy-header fade-in">
            <h1 class="privacy-title">Privacy Policy</h1>
            <p class="privacy-subtitle">KINGS AUTOHAUS - Protecting Your Privacy & Personal Information</p>
            <div class="last-updated">
                Last Updated: <span class="currentDate"></span>
            </div>
        </div>
        <!-- Corpo da política -->
        <div class="privacy-body">
            <!-- Introdução -->
            <div class="privacy-section fade-in delay-1">
                <h2 class="section-title">Introduction</h2>
                <p class="privacy-text">
                    Use of this website acknowledges your consent to this Privacy Policy for KINGS AUTOHAUS and our affiliated services. Protecting your private information is our priority and we are committed to safeguarding your privacy online. This Privacy Policy explains what personal information we may collect about you through our website, when we collect it, how we may use it, who we may disclose it to, and is intended to help you understand the terms and conditions surrounding the collection and use of your data.
                </p>
            </div>
            <!-- Informações Pessoais Coletadas -->
            <div class="privacy-section fade-in delay-2">
                <h2 class="section-title">Personal Information We Collect</h2>
                <p class="privacy-text">
                    Our primary goal in collecting your personal information is to enable us to personalize your interactions and experiences with our website. We may collect information that identifies, relates to, describes, references, is capable of being associated with, or could reasonably be linked, directly or indirectly, to you ("Personal Information").
                </p>
                <p class="privacy-text">In particular, our website has collected the following categories of Personal Information within the last twelve (12) months:</p>
                <table class="data-categories-table">
                    <thead>
                        <tr>
                            <th>Categories of Personal Information</th>
                            <th>Types of Personal Information Collected</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>A. Identifiers</strong></td>
                            <td>Name, telephone number, postal address, e-mail address, social security number, date of birth, account name, IP address, or other information you voluntarily provide.</td>
                        </tr>
                        <tr>
                            <td><strong>B. Personal Information Categories</strong></td>
                            <td>Name, address, telephone number, physical address, zip code, email address, company name, credit card number, income, driver's license number, or other financial information.</td>
                        </tr>
                        <tr>
                            <td><strong>C. Commercial Information</strong></td>
                            <td>Housing information, products or services purchased, and purchasing and consuming histories or tendencies.</td>
                        </tr>
                        <tr>
                            <td><strong>D. Internet Activity</strong></td>
                            <td>Type and version of browser, service provider, device identification information, search engine usage, and website interaction data.</td>
                        </tr>
                        <tr>
                            <td><strong>E. Geolocation Data</strong></td>
                            <td>Signals from your device that allow us to determine your location with reasonable precision.</td>
                        </tr>
                        <tr>
                            <td><strong>F. Professional Information</strong></td>
                            <td>Occupation, name of employer, employment status, employment history, or business email address.</td>
                        </tr>
                        <tr>
                            <td><strong>G. Inferences</strong></td>
                            <td>Information regarding your interaction with the website, application, advertisements, and browsing history.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- Como Coletamos -->
            <div class="privacy-section fade-in delay-3">
                <h2 class="section-title">How Your Personal Information Is Collected</h2>
                <p class="privacy-text">We collect Personal Information in several ways:</p>
                <ul class="privacy-list">
                    <li><strong>Vehicle Quote Requests:</strong> When you request a vehicle price quote, you may provide your name, address, telephone number, zip code, email address and other transactional information.</li>
                    <li><strong>Financing Applications:</strong> When applying for vehicle financing, we collect detailed personal and financial information necessary for credit evaluation.</li>
                    <li><strong>Monthly Payment Calculations:</strong> When using our digital retailing tools to calculate estimated monthly payments.</li>
                    <li><strong>Website Analytics:</strong> We automatically collect information about your device, browser, and how you interact with our website.</li>
                    <li><strong>Surveys and Contests:</strong> Participation is voluntary and may include demographic information.</li>
                </ul>
            </div>
            <!-- Como Usamos -->
            <div class="privacy-section fade-in delay-4">
                <h2 class="section-title">Use of Your Personal Information</h2>
                <p class="privacy-text">We may use or disclose the Personal Information we collect for one or more of the following business purposes:</p>
                <ul class="privacy-list">
                    <li>To operate our website and deliver the products and/or services you have requested</li>
                    <li>To process vehicle financing applications and communicate with financial institutions</li>
                    <li>To create, maintain, customize, and secure your account with us</li>
                    <li>To inform you of other products or services available from us or our affiliates</li>
                    <li>To contact you via surveys to conduct research about current or potential services</li>
                    <li>To respond to your inquiries and provide customer support</li>
                    <li>To improve our website, products, and services through analysis</li>
                    <li>To comply with legal obligations and protect our rights and interests</li>
                    <li>To detect security incidents and protect against fraudulent activity</li>
                </ul>
            </div>
            <!-- Cookies -->
            <div class="privacy-section fade-in delay-1">
                <h2 class="section-title">Use of Cookies</h2>
                <p class="privacy-text">
                    Our website uses "cookies" to help personalize your online experience. A cookie is a text file placed on your hard disk by a web page server. Cookies help us detect whether your device has accessed our website before and enable certain functions, including identifying vehicles you've previously viewed.
                </p>
                <p class="privacy-text">
                    We may also access YouTube API Services, which are subject to YouTube's Terms of Service and Google Privacy Policy. Users can revoke access via Google security settings or contact us with concerns.
                </p>
            </div>
            <!-- Compartilhamento -->
            <div class="privacy-section fade-in delay-2">
                <h2 class="section-title">Who We Share Your Personal Information With</h2>
                <p class="privacy-text">We do not sell, rent or lease our customer lists to third parties. We may share your Personal Information with:</p>
                <ul class="privacy-list">
                    <li>Financial institutions and lenders to process your credit applications</li>
                    <li>Service providers who assist us in operating our business</li>
                    <li>Our affiliates and trusted partners for marketing purposes</li>
                    <li>Original equipment manufacturers for analytics and dealer performance measurement</li>
                    <li>Third parties approved by you, including social media sites</li>
                    <li>Law enforcement when required by law or to protect our rights</li>
                </ul>
            </div>
            <!-- Retenção de Dados -->
            <div class="privacy-section fade-in delay-3">
                <h2 class="section-title">Data Retention</h2>
                <p class="privacy-text">
                    We retain Personal Information for the period necessary to fulfill the purposes outlined in this Privacy Policy, comply with legal requirements, or as required by law. Financial information related to credit applications may be retained for extended periods as required by financial regulations.
                </p>
            </div>
            <!-- Segurança -->
            <div class="privacy-section fade-in delay-4">
                <h2 class="section-title">Data Security</h2>
                <p class="privacy-text">
                    We implement reasonable security measures to protect your personal information from unauthorized access, use, or disclosure. When you submit sensitive information via our website, it is encrypted and transmitted securely. However, no method of transmission over the internet is 100% secure.
                </p>
            </div>
            <!-- Seus Direitos -->
            <div class="privacy-section fade-in delay-1">
                <h2 class="section-title">Your Rights</h2>
                <p class="privacy-text">You may have certain rights relating to your personal information, including the right to:</p>
                <ul class="privacy-list">
                    <li>Access your personal information held by us</li>
                    <li>Learn more about how we process your personal information</li>
                    <li>Have us correct inaccurate personal information</li>
                    <li>Request deletion of your personal information</li>
                    <li>Restrict our processing of your personal information</li>
                    <li>Opt-out of receiving marketing communications</li>
                    <li>Object to any processing of your personal information</li>
                    <li>Not be discriminated against for exercising your rights</li>
                </ul>
            </div>
            <!-- Menores de Idade -->
            <div class="privacy-section fade-in delay-2">
                <h2 class="section-title">Children Under Thirteen</h2>
                <p class="privacy-text">
                    We do not knowingly collect Personal Information from children under the age of thirteen. If you are under thirteen, you must ask your parent or guardian for permission to use this website. If we become aware that we have collected personal information from a child under 13, we will take steps to delete such information.
                </p>
            </div>
            <!-- Opt-out -->
            <div class="privacy-section fade-in delay-3">
                <h2 class="section-title">Opt-Out & Unsubscribe</h2>
                <p class="privacy-text">
                    You can opt-out of receiving marketing communications by contacting us or using the unsubscribe link in our emails. You may also opt-out of targeted advertising by visiting our "Your Privacy Choices" link in the website footer.
                </p>
            </div>
            <!-- Atualizações -->
            <div class="privacy-section fade-in delay-4">
                <h2 class="section-title">Updates to This Privacy Policy</h2>
                <p class="privacy-text">
                    We reserve the right to change and update this Privacy Policy when appropriate. We encourage you to review this policy periodically. Your continued use of our website following an update indicates your agreement to the revised policy.
                </p>
            </div>
            <!-- Contato -->
            <div class="contact-section fade-in delay-1">
                <h2 class="section-title">Contact Information</h2>
                <p class="privacy-text">
                    If you have questions about this Privacy Policy or wish to exercise your rights, please contact us:
                </p>
                <div class="contact-info">
                    <div class="contact-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <strong>Address</strong><br>
                        1286 Washington Street<br>
                        MA 01746
                    </div>
                    <div class="contact-item">
                        <i class="fas fa-phone"></i>
                        <strong>Phone</strong><br>
                        Office +1 (774)523-7860 
                        Mobile +1 (508)306-5516
                    </div>
                    <div class="contact-item">
                        <i class="fas fa-envelope"></i>
                        <strong>Email</strong><br>
                        <a href="mailto:paul@kingsautohaus.net" class="privacy-link">paul@kingsautohaus.net</a>
                    </div>
                </div>
            </div>
            <!-- Data de Atualização na parte inferior -->
            <div class="privacy-section fade-in delay-2" style="text-align: center; margin-top: 50px;">
                <h2 class="section-title">Additional Information</h2>
                <p class="privacy-text" style="color: #05FC04; font-weight: bold;">Page updated: <span class="currentDate"></span>
                </p>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Atualiza a data automaticamente
    const currentDateElements = document.querySelectorAll('.currentDate');
    const options = {
         year: 'numeric',
         month: 'long',
         day: 'numeric'
    };
    const formattedDate = new Date().toLocaleDateString('en-US', options);
    currentDateElements.forEach(element => {
        element.textContent = formattedDate;
    });

    // Indicador de progresso de leitura
    const progressBar = document.getElementById('readingProgress');

    function updateReadingProgress() {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        progressBar.style.width = scrolled + '%';
    }

    window.addEventListener('scroll', updateReadingProgress);

    // Animação suave para seções ao entrar na tela
    const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
    };
    const observer = new IntersectionObserver(function(entries) {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
            }
        });
    }, observerOptions);

    // Observa todas as seções
    document.querySelectorAll('.privacy-section').forEach(section => {
        section.style.opacity = '0';
        section.style.transform = 'translateY(20px)';
        section.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        observer.observe(section);
    });

    // Scroll suave para links internos
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        });
    });
});
</script>
</body>
</html>
