<!-- 
========================================
==  SCRIPT DO CARROSSEL CORRIGIDO       ==
========================================
-->
<script>
    // Scripts do Fade-in
    const fadeInElements = document.querySelectorAll('.fade-in-up');
    const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                observer.unobserve(entry.target);
            }
        });
    }, {
        threshold: 0.1
     });
    fadeInElements.forEach(element => {
        observer.observe(element);
    });

    // Classe do Carrossel (COM CORREÇÕES)
    class InfiniteCarousel {
        constructor(selector) {
            this.carousel = document.querySelector(selector);
            if (!this.carousel) return;
            this.carouselInner = this.carousel.querySelector('.featured-carousel-inner');
            if (!this.carouselInner) return;
            
            this.items = Array.from(this.carousel.querySelectorAll('.featured-car-item'));
            this.originalItems = [...this.items];
            this.totalItems = this.originalItems.length;
            this.currentIndex = 0;
            this.itemWidth = 0;
            this.visibleItems = 1;
            this.isTransitioning = false;
            this.autoPlayInterval = null;
            
            // ========================================
            // ==  CORREÇÃO 1: VELOCIDADE AUMENTADA  ==
            // ========================================
            this.autoPlayDelay = 2000; // 2 segundos (antes era 3000)

            // SÓ INICIA O CARROSSEL SE TIVER CARROS
            if (this.totalItems > 0) {
                this.init();
            } else {
                // Se não houver carros, esconde os botões e indicadores
                const nextBtn = document.querySelector('.carousel-next');
                const prevBtn = document.querySelector('.carousel-prev');
                const indicators = document.getElementById('carouselIndicators');
                if(nextBtn) nextBtn.style.display = 'none';
                if(prevBtn) prevBtn.style.display = 'none';
                if(indicators) indicators.style.display = 'none';
            }
        }
        
        init() {
            this.calculateDimensions();
            
            // CORREÇÃO: Só clona e faz loop se tiver mais carros do que o visível
            if (this.totalItems > this.visibleItems) {
                this.createClones();
                this.createIndicators();
                this.setInitialPosition();
                this.startAutoPlay();
            } else {
                // Se não tiver carros suficientes para rolar, apenas os exibe
                // e esconde os controles
                this.carouselInner.style.transform = 'translateX(0px)';
                const nextBtn = document.querySelector('.carousel-next');
                const prevBtn = document.querySelector('.carousel-prev');
                const indicators = document.getElementById('carouselIndicators');
                if(nextBtn) nextBtn.style.display = 'none';
                if(prevBtn) prevBtn.style.display = 'none';
                if(indicators) indicators.style.display = 'none';
            }
            
            this.bindEvents();
            this.updateActiveStates();
        }

        calculateDimensions() {
            const containerWidth = this.carousel.offsetWidth;
            const item = this.items[0];
            if (!item) return;
            
            // Pega a margem do CSS
            const itemStyle = window.getComputedStyle(item);
            const marginRight = parseInt(itemStyle.marginRight) || 0;
            const marginLeft = parseInt(itemStyle.marginLeft) || 0;

            // ========================================
            // ==  PONTO 3: LÓGICA DE RESPONSIVIDADE ==
            // ========================================
            if (window.innerWidth >= 1400) {
                this.visibleItems = 4;
            } else if (window.innerWidth >= 1200) {
                this.visibleItems = 4;
            } else if (window.innerWidth >= 992) {
                this.visibleItems = 3;
            } else if (window.innerWidth >= 768) {
                this.visibleItems = 2;
            } else {
                this.visibleItems = 1;
            }
            // ========================================

            // Calcula a largura de cada item para preencher o container
            const totalMargin = (marginLeft + marginRight) * this.visibleItems;
            this.itemWidth = (containerWidth - totalMargin + (marginLeft + marginRight)) / this.visibleItems;
            
            // Aplica a largura calculada a todos os itens (originais e futuros clones)
            this.items.forEach(i => {
                i.style.flexBasis = `${this.itemWidth - (marginLeft + marginRight)}px`;
            });
            
            // Recalcula a largura total do item (com margens) para o transform
            // CORREÇÃO: Garante que o itemWidth seja pego após o flexBasis ser setado
            if(this.items[0].offsetWidth > 0) {
                 this.itemWidth = this.items[0].offsetWidth + marginLeft + marginRight;
            }
        }

        createClones() {
            // CORREÇÃO: Lógica de clone mais segura
            if (this.totalItems <= 0) return;

            this.carouselInner.innerHTML = ''; // Limpa os itens originais
            
            const clonesNeeded = Math.max(this.visibleItems, 3); // Quantos clones no início/fim

            // Adiciona clones do fim no começo
            for (let i = 0; i < clonesNeeded; i++) {
                // Modulo para loop seguro
                const cloneIndex = ((this.totalItems - clonesNeeded + i) % this.totalItems + this.totalItems) % this.totalItems;
                const clone = this.originalItems[cloneIndex].cloneNode(true);
                clone.classList.add('clone');
                this.carouselInner.appendChild(clone);
            }

            // Adiciona os itens originais
            this.originalItems.forEach(item => {
                this.carouselInner.appendChild(item.cloneNode(true));
            });

            // Adiciona clones do começo no fim
            for (let i = 0; i < clonesNeeded; i++) {
                const cloneIndex = i % this.totalItems; // Modulo para loop seguro
                const clone = this.originalItems[cloneIndex].cloneNode(true);
                clone.classList.add('clone');
                this.carouselInner.appendChild(clone);
            }

            this.items = Array.from(this.carouselInner.querySelectorAll('.featured-car-item'));
            this.clonesAtStart = clonesNeeded;
            
            // Aplica a largura correta aos novos itens clonados
            this.items.forEach(i => {
                const itemStyle = window.getComputedStyle(i);
                const marginRight = parseInt(itemStyle.marginRight) || 0;
                const marginLeft = parseInt(itemStyle.marginLeft) || 0;
                i.style.flexBasis = `${(this.itemWidth - marginLeft - marginRight)}px`;
            });
        }
        
        createIndicators() {
            const indicatorsContainer = document.getElementById('carouselIndicators');
            if (!indicatorsContainer) return;
            indicatorsContainer.innerHTML = '';
            for (let i = 0; i < this.totalItems; i++) {
                const indicator = document.createElement('div');
                indicator.classList.add('indicator');
                if (i === 0) indicator.classList.add('active');
                indicator.addEventListener('click', () => this.goToSlide(i));
                indicatorsContainer.appendChild(indicator);
            }
            this.indicators = Array.from(indicatorsContainer.querySelectorAll('.indicator'));
        }

        setInitialPosition() {
            if (this.clonesAtStart > 0) {
                // CORREÇÃO: Atraso mínimo para garantir que o DOM está pronto
                setTimeout(() => {
                    const initialOffset = -this.clonesAtStart * this.itemWidth;
                    this.carouselInner.style.transform = `translateX(${initialOffset}px)`;
                    this.carouselInner.style.transition = 'none';
                }, 0);
            }
        }

        updateActiveStates() {
            this.items.forEach(item => item.classList.remove('active'));
            // CORREÇÃO: Garante que o índice exista
            const activeIndex = this.clonesAtStart + this.currentIndex;
            if (this.items[activeIndex]) {
                this.items[activeIndex].classList.add('active');
            }
            if (this.indicators) {
                this.indicators.forEach((indicator, index) => {
                    indicator.classList.toggle('active', index === this.currentIndex);
                });
            }
        }

        move(direction) {
            if (this.isTransitioning || this.totalItems <= this.visibleItems) return;
            
            this.isTransitioning = true;
            this.stopAutoPlay();
            this.currentIndex += direction;
            const offset = -(this.clonesAtStart + this.currentIndex) * this.itemWidth;
            this.carouselInner.style.transition = 'transform 0.5s cubic-bezier(0.4, 0, 0.2, 1)';
            this.carouselInner.style.transform = `translateX(${offset}px)`;

            setTimeout(() => {
                this.handleInfiniteLoop();
                this.updateActiveStates();
                this.isTransitioning = false;
                this.startAutoPlay();
            }, 500); // 500ms é a duração da transição
        }

        handleInfiniteLoop() {
            if (this.currentIndex >= this.totalItems) {
                this.currentIndex = 0;
                const offset = -this.clonesAtStart * this.itemWidth;
                this.carouselInner.style.transition = 'none';
                this.carouselInner.style.transform = `translateX(${offset}px)`;
            } else if (this.currentIndex < 0) {
                this.currentIndex = this.totalItems - 1;
                const offset = -(this.clonesAtStart + this.currentIndex) * this.itemWidth;
                this.carouselInner.style.transition = 'none';
                this.carouselInner.style.transform = `translateX(${offset}px)`;
            }
        }

        goToSlide(index) {
            if (this.isTransitioning || index === this.currentIndex) return;
            this.stopAutoPlay(); // Para o autoplay
            
            const diff = index - this.currentIndex;
            this.move(diff); // Move a quantidade de steps necessários
        }

        startAutoPlay() {
            if (this.totalItems <= this.visibleItems) return; // Não inicia se não houver loop
            this.stopAutoPlay();
            this.autoPlayInterval = setInterval(() => {
                this.move(1);
            }, this.autoPlayDelay);
        }

        stopAutoPlay() {
            if (this.autoPlayInterval) {
                clearInterval(this.autoPlayInterval);
                this.autoPlayInterval = null;
            }
        }

        bindEvents() {
            this.carousel.addEventListener('mouseenter', () => this.stopAutoPlay());
            this.carousel.addEventListener('mouseleave', () => this.startAutoPlay());
            let startX = 0;
            let isDown = false;
            
            const handleTouchStart = (e) => {
                startX = e.touches[0].clientX;
                isDown = true;
                this.stopAutoPlay();
            };
            const handleTouchMove = (e) => {
                if (!isDown) return;
                // Não previne o default para permitir scroll vertical
            };
            const handleTouchEnd = (e) => {
                if (!isDown) return;
                isDown = false;
                const endX = e.changedTouches[0].clientX;
                const diffX = startX - endX;
                if (Math.abs(diffX) > 50) {
 
                    if (diffX > 0) {
                        this.move(1); // Swipe left
                    } else {
                        this.move(-1); // Swipe right
                    }
                }
                this.startAutoPlay();
            };

            this.carousel.addEventListener('touchstart', handleTouchStart, { passive: true });
            this.carousel.addEventListener('touchmove', handleTouchMove, { passive: true });
            this.carousel.addEventListener('touchend', handleTouchEnd);

            window.addEventListener('resize', () => {
                clearTimeout(this.resizeTimeout);
                this.resizeTimeout = setTimeout(() => {
                    // Recria o carrossel do zero no resize
                    this.stopAutoPlay();
                    this.carouselInner.style.transition = 'none'; // Previne transição no resize
                    this.init();
                }, 250);
            });
        }
        
        destroy() {
            this.stopAutoPlay();
            if (this.resizeTimeout) {
                clearTimeout(this.resizeTimeout);
            }
            // Remover event listeners seria bom, mas por enquanto isso basta
        }
    }
    
    // Função global para os botões
    function moveCarousel(direction) {
        if (window.featuredCarousel) {
            // CORREÇÃO 3: Impede que o clique no botão ative o link do card
            event.stopPropagation(); 
            window.featuredCarousel.move(direction);
        }
    }

    // Inicialização do Script
    document.addEventListener('DOMContentLoaded', function() {
        
        // CORREÇÃO: Atrasar o início do carrossel 
        // para dar tempo do Handlebars e imagens carregarem
        setTimeout(() => {
            window.featuredCarousel = new InfiniteCarousel('.featured-carousel-wrapper');
        }, 500); // 500ms de atraso

        // Lógica do Modal de Contato
        const contactForm = document.getElementById('contactForm');
        const sendMessageButton = document.getElementById('sendMessageButton');
        const messageModal = document.getElementById('messageModal');
        const consentCheckbox = document.getElementById('consentCheckbox');
        
        if (sendMessageButton && contactForm && consentCheckbox) {
            let isSubmitting = false;
            sendMessageButton.addEventListener('click', async function(event) {
                event.preventDefault();
                if (isSubmitting) {
                    console.log('Form submission already in progress.');
                    return;
                }
                isSubmitting = true;
                if (!contactForm.checkValidity()) {
                    contactForm.classList.add('was-validated');
                    isSubmitting = false;
                    return;
                }
                if (!consentCheckbox.checked) {
                    // Removido o alert()
                    console.error('User did not consent.');
                    isSubmitting = false;
                    return;
                }
                const name = document.getElementById('contactName').value;
                const email = document.getElementById('contactEmail').value;
                const phone = document.getElementById('contactPhone').value;
                const message = document.getElementById('contactMessage').value;
                const formData = {
                    name: name,
                    email: email,
                    phone: phone,
                    message: message
                   };
                const originalButtonText = sendMessageButton.innerHTML;
                sendMessageButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Sending...';
                sendMessageButton.disabled = true;
                try {
                    const response = await fetch('/send-message', {
                        method: 'POST',
                        headers: {
                             'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(formData)
                    });
                    if (response.ok) {
                        const result = await response.json();
                        if (result.redirect) {
                            window.location.href = result.redirect;
                        } else {
                            // Sucesso
                            $(messageModal).modal('hide');
                            contactForm.reset();
                            contactForm.classList.remove('was-validated');
                        }
                    } else {
                        const errorData = await response.json();
                        console.error(`Error sending message: ${errorData.message || response.statusText}`);
                    }
                } catch (error) {
                    console.error('Network error:', error);
                } finally {
                    sendMessageButton.innerHTML = originalButtonText;
                    sendMessageButton.disabled = false;
                    isSubmitting = false;
                }
            });
        }
    });
</script>