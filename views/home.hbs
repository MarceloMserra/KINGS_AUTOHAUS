<style>
    /* Isto é IMPORTANTE: 
      Seu layout.hbs força um padding de 120px.
    Esta regra remove isso *apenas* para a home page,
      permitindo que a imagem vá até o topo.
    */
    body {
        padding-top: 0 !important;
    }

    /*
    ========================================
    ==  CSS ADICIONADO PARA OS BOTÕES     ==
    ========================================
    */
    .featured-carousel-wrapper {
        position: relative;
        /* CORREÇÃO: Removido o padding horizontal para os botões ficarem nos cantos */
    }

    .carousel-prev,
    .carousel-next {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background-color: rgba(0, 0, 0, 0.5);
        border: 1px solid #05FC04;
        color: #05FC04;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .carousel-prev:hover,
    .carousel-next:hover {
        background-color: #05FC04;
        color: #000;
    }

    /* ========================================
    ==  CORREÇÃO 2: Posição dos botões    ==
    ========================================
    */
    /* Posição da seta Esquerda (agora DENTRO do container) */
    .carousel-prev {
        left: 10px; 
    }

    /* Posição da seta Direita (agora DENTRO do container) */
    .carousel-next {
        right: 10px;
    }

    /* ========================================
    ==  CORREÇÃO 3: Card Clicável         ==
    ========================================
    */
    .featured-car-item a,
    .featured-car-item a:hover {
        text-decoration: none; /* Remove o sublinhado do link */
    }
    
    .featured-car-card {
        cursor: pointer; /* Mostra a "mãozinha" ao passar o mouse */
        transition: all 0.3s ease;
    }

    .featured-car-card:hover {
        transform: scale(1.02); /* Leve zoom ao passar o mouse */
        box-shadow: 0 0 20px rgba(5, 252, 4, 0.3);
    }


    /* Ajuste para telas pequenas */
    @media (max-width: 767px) {
        .carousel-prev {
            left: 5px; /* Botão dentro da área */
        }
        .carousel-next {
            right: 5px; /* Botão dentro da área */
        }
    }
    /* ======================================== */

</style>

